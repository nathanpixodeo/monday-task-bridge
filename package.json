{
  "name": "monday-task-bridge",
  "version": "0.2.0",
  "description": "Local Chrome extension and MCP bridge for reading monday.com tasks and original images through a signed-in browser session.",
  "private": true,
  "license": "UNLICENSED",
  "keywords": ["monday-com", "mcp", "chrome-extension", "local-first", "typescript"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathanpixodeo/monday-task-bridge.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "bridge": "tsx bridge/server.ts",
    "mcp": "tsx bridge/mcp.ts",
    "pair": "tsx bridge/pair-cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
