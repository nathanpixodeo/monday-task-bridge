{
  "manifest_version": 3,
  "name": "Monday Task Bridge",
  "version": "0.2.0",
  "description": "Captures Monday.com task data and sends it to the local bridge server.",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://*.monday.com/*",
    "http://127.0.0.1:3457/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.monday.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
