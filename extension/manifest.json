{
  "manifest_version": 3,
  "name": "Monday Task Bridge",
  "version": "0.5.0",
  "description": "Read monday.com tasks and original images with your signed-in session, for a paired local MCP bridge.",
  "author": {
    "email": "nathanpixodeo@gmail.com"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://*.monday.com/*",
    "https://files-monday-com.s3.amazonaws.com/*",
    "http://127.0.0.1:3457/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-off-16.png",
      "32": "icons/icon-off-32.png"
    }
  }
}
